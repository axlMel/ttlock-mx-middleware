{
  "name": "gtlock-middleware",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && node --env-file=.env dist/app/main.js",
    "prestart": "npm run build",
    "start": "node dist/app/main.js",
    "test": "jest --runInBand",
    "lint": "eslint src && tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "bullmq": "^6.3.13",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1"
  }
}
