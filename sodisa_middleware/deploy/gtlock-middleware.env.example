# Solo variables no secretas. Los valores sensibles llegan por LoadCredential.
# Pruebas: 364:2. Producción, después de validar la unidad de pruebas: 364:1.
ENABLED_COMPANIES=364:2
ASSIGNMENT_TZ=UTC
POLL_INTERVAL_MS_ROUTES=10000
CHAIN_POLL_INTERVAL_MS=60000
CHAIN_MAX_QUERIES_PER_SECOND=3
ACK_RETRY_BACKOFF_MS=150000
ACK_MAX_RETRIES=3
ACK_RESEND_ENABLED=true
CATALOG_REVALIDATE_MS=300000
CHAIN_BATCH_LIMIT=500
CHAIN_OVERLAP_MS=10000
PARTITION_REFRESH_MS=600000
COMMAND_API_URL=https://metrics.globaltrack.com.mx/udp-api/api/v1/commands/send
COMMAND_API_TIMEOUT_MS=10000
# Cambiar a true antes del primer arranque (modo sombra); el valor por defecto es false.
COMMAND_DRY_RUN=false
AUDIT_LOG_DIR=/var/lib/gtlock-middleware/audit
# CREDENTIALS_DIRECTORY lo establece systemd; no definirlo aquí.
